{
  "name": "dreams",
  "version": "1.0.0",
  "homepage": "/",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "vite --open",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:once": "vitest run",
    "openapi": "swagger-typescript-api generate -p ~/Dokumente/Code/dreams-api/docs/swagger.json -o ./src/api -n generated_api.ts",
    "tsc": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "knip",
    "dependencies:ci": "pnpm exec depcruise src  --include-only \"^src\"",
    "dependencies:table": "pnpm exec depcruise src  --include-only \"^src\" --output-type html > graph.html",
    "dependencies:graph": "pnpm exec depcruise --include-only \"^src\" --output-type dot src | dot -T svg > graph.svg",
    "check": "pnpm tsc && pnpm lint && pnpm knip && pnpm dependencies:ci && pnpm test:once",
    "licenses:summary": "pnpm dlx license-checker --summary",
    "licenses:check": "pnpm dlx license-checker --onlyAllow --prod 'MIT;ISC;Apache-2.0'"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@js-temporal/polyfill": "^0.5.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-charts": "^9.15.0",
    "@tanstack/react-virtual": "^3.14.19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "immer": "^11.1.21",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "react-tagcloud": "^2.3.3",
    "regenerator-runtime": "^0.14.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@lizenz/checker": "^0.0.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-tagcloud": "^2.3.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "dependency-cruiser": "^18.6.0",
    "happy-dom": "^21.0.1",
    "knip": "^6.41.0",
    "lefthook": "^2.2.2",
    "msw": "^3.0.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "rollup-plugin-visualizer": "^7.1.1",
    "swagger-typescript-api": "^13.13.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.4",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^5.0.4"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "24",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@11.21.0"
}
