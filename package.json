{
  "name": "dreams",
  "version": "1.0.0",
  "private": true,
  "homepage": "/",
  "type": "module",
  "scripts": {
    "start": "vite --open",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:once": "vitest run",
    "openapi": "swagger-typescript-api generate -p ~/Dokumente/Code/dreams-api/docs/swagger.json -o ./src/api -n generated_api.ts",
    "tsc": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "knip",
    "dependencies:ci": "pnpm exec depcruise src  --include-only \"^src\"",
    "dependencies:table": "pnpm exec depcruise src  --include-only \"^src\" --output-type html > graph.html",
    "dependencies:graph": "pnpm exec depcruise --include-only \"^src\" --output-type dot src | dot -T svg > graph.svg",
    "check": "pnpm tsc && pnpm lint && pnpm knip && pnpm test:once"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/x-charts": "^8.29.3",
    "@tanstack/react-virtual": "^3.14.10",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "immer": "^11.1.18",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "react-tagcloud": "^2.3.3",
    "regenerator-runtime": "^0.14.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-tagcloud": "^2.3.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "dependency-cruiser": "^18.2.0",
    "jsdom": "^27.4.0",
    "knip": "^6.32.3",
    "msw": "^2.15.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rollup-plugin-visualizer": "^6.0.11",
    "swagger-typescript-api": "^13.12.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-checker": "^0.12.0",
    "vitest": "^4.1.11"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "24",
      "onFail": "error"
    }
  }
}
