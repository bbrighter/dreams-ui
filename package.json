{
  "name": "dreams",
  "version": "1.0.0",
  "private": true,
  "homepage": "/",
  "packageManager": "pnpm@10.11.1",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@mui/x-charts": "^8.26.0",
    "@vitest/coverage-v8": "^4.0.18",
    "date-fns": "^4.1.0",
    "dependency-cruiser": "^17.3.6",
    "immer": "^11.1.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.12.0",
    "react-speech-recognition": "^3.10.0",
    "react-tagcloud": "^2.3.3",
    "regenerator-runtime": "^0.14.1",
    "zustand": "^5.0.10"
  },
  "scripts": {
    "start": "vite --open",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "openapi": "swagger-typescript-api generate -p ~/Dokumente/Code/dreams-api/docs/swagger.json -o ./src/api -n generated_api.ts",
    "tsc": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "knip": "knip",
    "dependencies:ci": "npx depcruise src  --include-only \"^src\"",
    "dependencies:table": "npx depcruise src  --include-only \"^src\" --output-type html > graph.html",
    "dependencies:graph": "npx depcruise --include-only \"^src\" --output-type dot src | dot -T svg > graph.svg"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@stylistic/eslint-plugin": "^5.7.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@types/react-speech-recognition": "^3.9.6",
    "@types/react-tagcloud": "^2.3.2",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "knip": "^5.82.1",
    "msw": "^2.12.7",
    "rollup-plugin-visualizer": "^6.0.5",
    "swagger-typescript-api": "^13.2.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vite": "^7.3.1",
    "vite-plugin-checker": "^0.12.0",
    "vitest": "^4.0.18"
  }
}