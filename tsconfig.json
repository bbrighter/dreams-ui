{
  "compilerOptions": {
    "sourceMap": true,
    "strictNullChecks": true,
    "module": "esnext",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "target": "ES2020",
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "lib": [
      "ES2021",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "@testing-library/jest-dom",
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules"
  ]
}